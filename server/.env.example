# ─── core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://apple@localhost:5432/adpilot?schema=public&connection_limit=20&pool_timeout=20"
PORT=4000
NODE_ENV=development

# ─── cache / shared state ────────────────────────────────────────────────────
# Backs rate limits, the ad-serving hot path and job coordination across
# instances. Leave blank to fall back to per-process memory (single node only).
REDIS_URL="redis://localhost:6379"

# ─── email ───────────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank in development: mail is written to the log and the
# EmailLog table instead of being sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false
MAIL_FROM="AdPilot <no-reply@adpilot.io>"
PANEL_URL="http://localhost:5173"

# ─── trust & safety ──────────────────────────────────────────────────────────
# Optional: https://developers.google.com/safe-browsing/v4 key for scanning
# creative destinations. Without it, only structural URL checks run.
SAFE_BROWSING_API_KEY=""

# ─── tax & invoicing ─────────────────────────────────────────────────────────
INVOICE_PREFIX="ADP"
TAX_LABEL="GST"
TAX_RATE_BPS=1800
PLATFORM_LEGAL_NAME="AdPilot Technologies"
PLATFORM_TAX_ID=""
PLATFORM_ADDRESS="1 Commerce Street, Bengaluru, India"

# ─── privacy ─────────────────────────────────────────────────────────────────
PRIVACY_POLICY_VERSION="2026-09-01"

# ─── observability ───────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Optional Sentry-compatible DSN for error reporting.
ERROR_DSN=""

# ─── platform timezone ───────────────────────────────────────────────────────
# Daily budgets, pacing and default report bucketing use this.
PLATFORM_TIMEZONE="Asia/Kolkata"

# ─── security ────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="dev-session-secret-change-me"
IMPRESSION_SECRET="dev-impression-secret-change-me"
SESSION_TTL_HOURS=12
# Cookie scope. Leave blank for localhost; set to ".yourdomain.com" in production
# so the panel and the API share the session cookie.
COOKIE_DOMAIN=

# Panel origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID (Web)
# Authorised JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=""
# Restrict end-user signups to one Workspace domain (optional, e.g. "acme.com")
GOOGLE_HOSTED_DOMAIN=""

# DEVELOPMENT ONLY. End users are Google-only in production; this flag lets the
# seeded demo accounts sign in with a password so the stack is usable without
# Google credentials. The server refuses to boot with this true in production.
DEV_ALLOW_PASSWORD_LOGIN=true

# ─── Razorpay (vendor wallet top-ups) ────────────────────────────────────────
# https://dashboard.razorpay.com/app/keys  —  test keys start with rzp_test_
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Point at a local stand-in to exercise the flow without an account:
#   npm run mock:razorpay   →   RAZORPAY_API_BASE="http://localhost:4100/v1"
# Leave unset in production; the server refuses to boot if it is not the real host.
RAZORPAY_API_BASE="https://api.razorpay.com/v1"
# Dashboard → Settings → Webhooks → create endpoint POST /api/webhooks/razorpay
# subscribed to payment.captured and payment.failed, then paste its secret here.
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY=INR
# USD is the platform's unit of account; Razorpay charges in RAZORPAY_CURRENCY.
USD_TO_CURRENCY_RATE=88.5

# ─── RazorpayX (optional: automated end-user payouts) ────────────────────────
# Leave blank to keep payouts fully manual.
RAZORPAYX_ACCOUNT_NUMBER=""
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""

# ─── economics (defaults; editable live in the super-admin panel) ────────────
DEFAULT_REV_SHARE_BPS=6000

# ─── geo ─────────────────────────────────────────────────────────────────────
GEO_PROVIDER=local
GEO_API_URL="http://ip-api.com/json/{ip}?fields=status,countryCode,regionName,city,district"
