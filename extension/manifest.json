{
  "manifest_version": 3,
  "name": "AdPilot \u2014 earn while your AI thinks",
  "version": "0.2.0",
  "description": "Shows a small sponsored card while a frontier model is thinking, and pays you for every view.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://api.adpilot.io/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "AdPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
